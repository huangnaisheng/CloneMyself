# Copy to .env and fill in.  Nothing identifying belongs in source control.
# The pipeline refuses to run while TARGET_UIN / TARGET_NAME / TARGET_GROUP
# are empty.

# --- who we are imitating -------------------------------------------------
TARGET_UIN=
TARGET_NAME=
TARGET_GROUP=

# --- paths ---------------------------------------------------------------
# Directory holding the exporter's "*_chunked_jsonl" folders.
EXPORTS_DIR=C:/path/to/qq/exports
# Local Qwen3-8B (safetensors) directory.
BASE_MODEL=D:/models/Qwen3-8B
# Where the built datasets are written / read from.
DATASET_OUT=./data
# LoRA output directory for training.
OUT_DIR=./lora-out

# --- huggingface cache ---------------------------------------------------
# Keep this off ~/.cache on Windows: it often hits WinError 5 permission issues.
HF_HOME=D:/models/hf_cache
HF_DATASETS_CACHE=D:/models/hf_cache/datasets

# --- the 12 GB VRAM survival kit -----------------------------------------
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# --- training knobs ------------------------------------------------------
MAX_LEN=512
BATCH=1
GRAD_ACCUM=8
LR=5e-5
MAX_STEPS=300
REPLY_REPEAT=3
MAX_CONTINUE=2500
EVAL_STEPS=25
SAVE_STEPS=25
PATIENCE=5
